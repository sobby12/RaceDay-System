
@model IEnumerable<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-4">
    <h1>Manage Categories</h1>
    <p class="text-muted">Create and manage categories for RaceDay events.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">
        Add New Category
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No categories found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Event ID</th>
                        <th>Category Name</th>
                        <th>Type</th>
                        <th>Minimum Age</th>
                        <th>Maximum Age</th>
                        <th>Distance (KM)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.EventId</td>
                            <td>@category.CategoryName</td>
                            <td>@category.CategoryType</td>
                            <td>@(category.MinAge?.ToString() ?? "-")</td>
                            <td>@(category.MaxAge?.ToString() ?? "-")</td>
                            <td>@(category.CategoryDistanceKm?.ToString("0.00") ?? "-")</td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@category.CategoryId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="OrganizerDashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
