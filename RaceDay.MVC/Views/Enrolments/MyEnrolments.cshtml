
@model List<RaceDay.MVC.Controllers.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">My Enrolments</h2>
            <p class="text-muted">Manage your registered events.</p>
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No Enrolments Found</h5>

                <p class="text-muted">
                    You have not enrolled in any events yet.
                </p>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-success">
                    Browse Available Events
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h5 class="mb-3">Your Registered Events</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                <tr>
                                    <td>@enrolment.EnrollmentId</td>

                                    <td>
                                        <strong>
                                            @(string.IsNullOrWhiteSpace(enrolment.EventName)
                                                ? $"Event {enrolment.EventId}"
                                                : enrolment.EventName)
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(enrolment.CategoryName)
                                            ? $"Category {enrolment.CategoryId}"
                                            : enrolment.CategoryName)
                                    </td>

                                    <td>
                                        @enrolment.EnrollmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (string.Equals(
                                            enrolment.Status,
                                            "Registered",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                Registered
                                            </span>
                                        }
                                        else if (string.Equals(
                                            enrolment.Status,
                                            "Cancelled",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                @enrolment.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (string.Equals(
                                            enrolment.Status,
                                            "Registered",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-controller="Enrolments"
                                                  asp-action="Cancel"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@enrolment.EnrollmentId" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Cancel Enrolment
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No action available
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>


