
@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<h2 class="mb-4">Browse RaceDay Events</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @item.EventName
                        </h5>

                        <p>
                            <strong>Date:</strong>
                            @item.EventDate.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            <strong>Location:</strong>
                            @item.Location
                        </p>

                        <p>
                            <strong>Type:</strong>
                            @item.EventType
                        </p>

                        <p>
                            <strong>Distance:</strong>
                            @item.DistanceKm km
                        </p>

                        <p>
                            <strong>Entry Fee:</strong>
                            R @item.EntryFee
                        </p>

                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@item.EventId"
                           class="btn btn-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No events are currently available.
    </div>
}

