
@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";

    var userRole = Context.Session.GetString("UserRole");
    var isOrganizer = string.Equals(
        userRole,
        "Organizer",
        StringComparison.OrdinalIgnoreCase);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Browse RaceDay Events</h2>

        @if (isOrganizer)
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create Event
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Type:</strong>
                                @item.EventType
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.DistanceKm km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @item.EntryFee
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-primary mb-2">
                                View Details
                            </a>

                            @if (isOrganizer)
                            {
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-warning mb-2">
                                    Edit
                                </a>

                                <form asp-controller="Events"
                                      asp-action="Delete"
                                      asp-route-id="@item.EventId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger mb-2">
                                        Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
</div>

