
@model RaceDay.MVC.Models.CategoryViewModel
@using RaceDay.MVC.Models

@{
    ViewData["Title"] = "Create Category";
    var events = ViewBag.Events as List<EventViewModel> ?? new List<EventViewModel>();
}

<div class="container mt-4">
    <h1>Create Category</h1>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label">Select Event</label>
            <select asp-for="EventId" class="form-select">
                <option value="">-- Select an event --</option>
                @foreach (var item in events)
                {
                    <option value="@item.EventId">@item.EventName</option>
                }
            </select>
            <span asp-validation-for="EventId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">Category Name</label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryType" class="form-label">Category Type</label>
            <select asp-for="CategoryType" class="form-select">
                <option value="">-- Select type --</option>
                <option value="Distance">Distance</option>
                <option value="Age">Age</option>
            </select>
            <span asp-validation-for="CategoryType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MinAge" class="form-label">Minimum Age (optional)</label>
            <input asp-for="MinAge" type="number" min="0" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxAge" class="form-label">Maximum Age (optional)</label>
            <input asp-for="MaxAge" type="number" min="0" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryDistanceKm" class="form-label">Distance in KM (optional)</label>
            <input asp-for="CategoryDistanceKm" type="number" min="0.01" step="0.01" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Save Category</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
